# Database
DATABASE_BACKEND=falkordb
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_GRAPH=mind

# Optional agent enrichment before code edits. When enabled, MCP clients are
# instructed to call code_context(path=...) immediately before modifying code.
MIND_CODE_CONTEXT_ENABLED=false
# Empty scans all FalkorDB graphs; comma-separate names to restrict the scan.
MIND_CODE_CONTEXT_GRAPHS=
# Optional graphs.json used by graph_diff for canonical/runtime comparison.
MIND_GRAPH_MANIFEST=
# Fixed Telegram destination used by the broadcast MCP tool.
MIND_TELEGRAM_BROADCAST_CHAT_ID=-1001699255893
# Shared alarm storage used by schedule_wake and the background watcher.
MIND_CITIZENS_DIR=

# Embedding Provider
# Options: local (default, no API key), openai (requires OPENAI_API_KEY)
EMBEDDING_PROVIDER=local

# OpenAI Configuration (required if EMBEDDING_PROVIDER=openai)
OPENAI_API_KEY=sk-...
# Model: text-embedding-3-large (3072d, default) or text-embedding-3-small (1536d)
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
